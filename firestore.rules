rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de ayuda para verificar si un usuario es administrador de forma segura
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc != null && userDoc.data.role == 'admin';
    }

    // Reglas para colecciones públicas (sin autenticación)
    match /settings/{document} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    match /news/{document} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    match /poolConfig/{document} {
      allow read, list: if true;
    }
    match /profitabilitySettings/{document} {
      allow read, list: if true;
    }
    match /performanceStats/{document} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    match /siteUpdates/{document} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Reglas para colecciones que requieren autenticación
    match /users/{userId} {
      // Un usuario autenticado puede leer, crear y actualizar su propio documento
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      // Los administradores tienen acceso completo a todos los documentos de usuario
      allow read, write: if isAdmin();

      // Subcolección para los portfolios de trading
      match /portfolios/{portfolioId} {
        // Un usuario autenticado puede leer, crear y actualizar su propio portfolio
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false; // Denegar eliminación de portfolios

        // Subcolección para las transacciones del portfolio
        match /transactions/{transactionId} {
          allow read, create: if request.auth != null && request.auth.uid == userId;
          allow update, delete: if false;
        }
      }

      // Subcolección para secretos de usuario (API Keys, etc.)
      match /secrets/{secretId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección para historial de trades ejecutados manualmente
      match /userTrades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /miners/{minerId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow list: if request.auth != null; // Permitir listar todos los mineros para usuarios autenticados
      allow read, write: if isAdmin();
    }

    match /userBalances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read, write: if isAdmin();
    }

    match /arbitragePools/{poolId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow write: if isAdmin();
    }

    match /userArbitragePools/{documentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow read: if isAdmin();
    }

    match /contactRequests/{ticketId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update: if isAdmin();
    }

    // Reglas para señales de trading
    match /tradingSignals/{signalId} {
      allow read, list: if request.auth != null; // Los usuarios autenticados pueden leer las señales
      allow create, update, delete: if isAdmin(); // Solo los administradores pueden crear, actualizar y eliminar
    }

    // Reglas para el sistema P2P
    match /p2p_offers/{offerId} {
      allow read, list: if request.auth != null; // Cualquier usuario autenticado puede ver las ofertas
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId; // Solo el propietario puede crear su oferta
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId; // Solo el propietario puede modificar/eliminar su oferta
      // Los administradores también pueden modificar/eliminar si se requiere supervisión
      allow update, delete: if isAdmin();
    }

    match /p2p_trades/{tradeId} {
      allow create: if request.auth != null; // Cualquier usuario autenticado puede iniciar un trade
      allow read: if request.auth != null && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId); // Solo los participantes pueden leer el trade
      allow update: if request.auth != null && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId); // Los participantes pueden actualizar el trade (ej. confirmar pago, liberar fondos)
      allow update: if isAdmin(); // Los administradores también pueden modificar
      allow delete: if false; // Los trades no deben ser eliminados fácilmente, solo cancelados/archivados
    }

    // Reglas para suscripciones VIP
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
      allow read, write: if isAdmin();
    }

    // Reglas para planes VIP
    match /vipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para el historial de trading
    match /tradingHistory/{historyId} {
      allow read, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    // Reglas para depósitos y direcciones
    match /depositAddresses/{addressId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /deposits/{depositId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reglas para el Chat VIP (Público)
    match /vipChat/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Reglas para el Chat de Soporte (Privado)
    match /privateVipMessages/{msgId} {
      // Un usuario puede leer si es el destinatario (userId) o el remitente (senderId)
      // O si es administrador
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.senderId == request.auth.uid || 
        isAdmin()
      );
      // Un usuario puede crear si se identifica correctamente como remitente
      // O si es administrador actuando como soporte
      allow create: if request.auth != null && (
        request.resource.data.senderId == request.auth.uid || 
        isAdmin()
      );
      // Permitir borrado a administradores
      allow delete: if isAdmin();
    }

    // Reglas para el Fondo Colectivo
    match /collectiveFundContributions/{contributionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // Reglas adicionales para configuraciones específicas del sitio
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para el Cajero Airtm
    match /airtmSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para el Sistema de Bots dinámicos
    match /userBots/{botId} {
      // Permitir leer si el usuario es el dueño (ayuda con queries y get)
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      
      // Permitir crear si el userId enviado es el del usuario logueado
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Permitir modificar o borrar si es el dueño
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Los administradores tienen acceso completo
      allow read, write: if isAdmin();
    }

    // Regla general para cualquier otra colección (denegar todo)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
